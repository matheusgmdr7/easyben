# ===========================================
# CONFIGURAÇÕES DO SUPABASE (OBRIGATÓRIAS)
# ===========================================

# URL do seu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública (anon key) do Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de serviço do Supabase (para operações admin)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===========================================
# CONFIGURAÇÕES DE EMAIL (OPCIONAIS)
# ===========================================

# Para envio de emails via Resend (ATUAL - Recomendado)
RESEND_API_KEY=re_seu_api_key_aqui

# Para envio de emails via SendGrid (alternativo)
SENDGRID_API_KEY=SG.seu_api_key_aqui

# Email remetente padrão
FROM_EMAIL=contato@contratandoplanos.com.br

# ===========================================
# CONFIGURAÇÕES DO NETLIFY EMAIL FUNCTIONS
# ===========================================
# ATENÇÃO: Estas variáveis são para Netlify Email Functions
# Se você estiver usando Supabase Edge Functions (atual), NÃO precisa dessas

# Diretório dos templates de email do Netlify
NETLIFY_EMAILS_DIRECTORY=netlify/emails

# Secret para autenticação do Netlify Email Functions
NETLIFY_EMAILS_SECRET=seu_secret_aleatorio_aqui

# ===========================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# ===========================================

# Ambiente de execução
NODE_ENV=development

# URL base da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# CONFIGURAÇÕES DE SEGURANÇA
# ===========================================

# Secret para JWT tokens (gere uma string aleatória)
JWT_SECRET=sua_string_secreta_muito_longa_e_aleatoria

# Secret para NextAuth (se usar)
NEXTAUTH_SECRET=outra_string_secreta_para_nextauth

# URL para NextAuth
NEXTAUTH_URL=http://localhost:3000

# ===========================================
# CONFIGURAÇÕES DE STORAGE/UPLOAD
# ===========================================

# Tamanho máximo de upload (em bytes)
MAX_FILE_SIZE=10485760

# Tipos de arquivo permitidos
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# ===========================================
# CONFIGURAÇÕES DE API EXTERNA (OPCIONAIS)
# ===========================================

# Para integração com WhatsApp Business API
WHATSAPP_API_TOKEN=seu_token_whatsapp

# Twilio WhatsApp (cobranças automáticas)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+5511999999999
# URL pública base para validação de assinatura dos webhooks (ex.: https://easyben.com.br)
TWILIO_WEBHOOK_BASE_URL=
# Apenas desenvolvimento local (ngrok): TWILIO_SKIP_WEBHOOK_VALIDATION=1

# Redis / Upstash (filas BullMQ — workers WhatsApp no Railway)
REDIS_URL=
# ou
UPSTASH_REDIS_URL=

# Cron — Netlify Scheduled Function (netlify/functions/whatsapp-billing-reminders.ts)
# CRON_SECRET só é necessário se chamar manualmente a rota /api/cron/whatsapp-billing-reminders
CRON_SECRET=

# ===========================================
# NETLIFY (Site → Environment variables → Production)
# ===========================================
# Obrigatórias para WhatsApp cobranças:
#   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_WHATSAPP_NUMBER
#   TWILIO_WEBHOOK_BASE_URL=https://easyben.com.br
#   UPSTASH_REDIS_URL=rediss://...
#  
NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY (+ demais vars do app)
#
# Cron: netlify.toml + netlify/functions/whatsapp-billing-reminders.ts (09:00 BRT)
#
# Workers BullMQ: deploy separado no Railway
#   Dockerfile: Dockerfile.workers (Settings → Builder → Dockerfile)
#   Ou: railway.toml aponta dockerfilePath = Dockerfile.workers
#   Start: npm run workers:whatsapp:prod
#   Build env Railway: PUPPETEER_SKIP_DOWNLOAD=true
#   Mesmas vars Twilio + Upstash + Supabase no Railway

# Para integração com APIs de CEP
VIACEP_API_URL=https://viacep.com.br/ws

# ===========================================
# CONFIGURAÇÕES DE MONITORAMENTO (OPCIONAIS)
# ===========================================

# Para Sentry (monitoramento de erros)
SENTRY_DSN=https://seu_dsn_sentry

# Para Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ===========================================
# CONFIGURAÇÕES DE PRODUÇÃO
# ===========================================

# Domínio de produção
PRODUCTION_URL=https://contratandoplanos.com.br

# Configurações de CORS
ALLOWED_ORIGINS=http://localhost:3000,https://contratandoplanos.com.br
