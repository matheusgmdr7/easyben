{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["gru1"],
  "crons": [
    {
      "path": "/api/cron/whatsapp-billing-reminders?janela=manha",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/whatsapp-billing-reminders?janela=tarde",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/whatsapp-billing-recovery",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/whatsapp-billing-reminders-catchup",
      "schedule": "*/15 11-21 * * *"
    }
  ],
  "functions": {
    "app/**/*.ts": {
      "runtime": "nodejs18.x"
    }
  },
  "env": {
    "NODE_VERSION": "18.17.0"
  }
}
